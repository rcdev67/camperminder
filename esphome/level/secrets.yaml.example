# Kopiere diese Datei nach  secrets.yaml  und trage deine Werte ein.
# (secrets.yaml gehört NICHT ins öffentliche Repo -> siehe .gitignore)

# 32-Byte Base64-Key: in ESPHome über "Encryption key" generieren lassen
camperminder_api_key: "BASE64_API_KEY_HIER"

camperminder_ota_password: "OTA_PASSWORT_HIER"

# Ein Passwort für das geräteeigene Netz steht hier bewusst NICHT.
#
# Das Netz "CamperMinder" ist ab Werk offen. Es existiert nur, solange kein
# WLAN eingetragen ist - also im Handbetrieb und während der Einrichtung. Wer
# es abschließen will, trägt auf der Geräteseite unter Technik ein eigenes
# Passwort ein; das Gerät merkt es sich.
#
# Ein Passwort ab Werk wäre entweder für alle Geräte gleich (und stünde nach
# dem ersten verkauften Gerät in jedem Forum) oder je Gerät verschieden (dann
# braucht es einen Aufkleber, und nach Werkseinstellungen stimmt der nicht
# mehr). Beides war gebaut, beides war schlechter.

# --------------------------------------------------------------------------
# wifi_ssid und wifi_password stehen hier bewusst NICHT mehr.
#
# Die ausgelieferte Firmware bringt kein WLAN mit: Das Gerät öffnet beim ersten
# Einschalten sein eigenes Netz. Der Kunde verbindet sich damit, ruft die
# Geräteseite auf und trägt sein WLAN dort ein - falls er es überhaupt will.
#
# Das ist zugleich Bedingung dafür, dass diese Eingabe erhalten bleibt: Laut
# ESPHome behält das Gerät gespeicherte Zugangsdaten nur, solange in der
# Konfiguration keine stehen.
# --------------------------------------------------------------------------

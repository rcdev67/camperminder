# Kopiere diese Datei nach  secrets.yaml  und trage deine Werte ein.
# (secrets.yaml gehoert NICHT ins oeffentliche Repo -> siehe .gitignore)

# 32-Byte Base64-Key: in ESPHome ueber "Encryption key" generieren lassen
campermaid_api_key: "BASE64_API_KEY_HIER"

campermaid_ota_password: "OTA_PASSWORT_HIER"

# Passwort des geraeteeigenen Netzes "CamperMaid". Das braucht der Kunde, um
# sich ueberhaupt mit dem Geraet zu verbinden - es gehoert also auf die
# Kurzanleitung und nicht in die Geheimnisse im Wortsinn.
campermaid_fallback_password: "FALLBACK_AP_PASSWORT_HIER"

# --------------------------------------------------------------------------
# wifi_ssid und wifi_password stehen hier bewusst NICHT mehr.
#
# Die ausgelieferte Firmware bringt kein WLAN mit: Das Geraet oeffnet beim
# ersten Einschalten sein eigenes Netz, und der Kunde traegt sein WLAN im
# Captive Portal ein - falls er es ueberhaupt will.
#
# Das ist zugleich Bedingung dafuer, dass diese Eingabe erhalten bleibt: Laut
# ESPHome behaelt das Geraet gespeicherte Zugangsdaten nur, solange in der
# Konfiguration keine stehen.
# --------------------------------------------------------------------------

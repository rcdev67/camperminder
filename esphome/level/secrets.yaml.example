# Kopiere diese Datei nach  secrets.yaml  und trage deine Werte ein.
# (secrets.yaml gehört NICHT ins öffentliche Repo -> siehe .gitignore)

# 32-Byte Base64-Key: in ESPHome über "Encryption key" generieren lassen
camperminder_api_key: "BASE64_API_KEY_HIER"

camperminder_ota_password: "OTA_PASSWORT_HIER"

# Rückfallwert für das Passwort des geräteeigenen Netzes "CamperMinder".
#
# ER GILT IM BETRIEB NICHT. Jedes Gerät rechnet sich beim Start ein eigenes
# Passwort aus zehn Zeichen aus. Dieser Wert greift nur, bis das geschehen
# ist - und als Netz, falls die Rechnung je scheitert. Ohne ihn stünde ein
# Gerät im Fehlerfall ohne jeden Zugang da, und zwar genau das, an dem man den
# Fehler beheben müsste.
camperminder_fallback_password: "FALLBACK_AP_PASSWORT_HIER"

# Geheime Zutat für dieses Passwort. Aus ihr und der MAC-Adresse des Geräts
# entsteht das, was auf dem Aufkleber steht - siehe hardware.yaml.
#
# Eine lange Zufallszeichenkette, etwa so erzeugt:
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
#
# NIEMALS ÄNDERN, sobald ein Gerät ausgeliefert ist: Eine neue Zutat bedeutet
# ein neues Passwort für JEDES Gerät, und kein Aufkleber stimmt mehr.
camperminder_ap_salt: "LANGE_ZUFALLSZEICHENKETTE_HIER"

# --------------------------------------------------------------------------
# wifi_ssid und wifi_password stehen hier bewusst NICHT mehr.
#
# Die ausgelieferte Firmware bringt kein WLAN mit: Das Gerät öffnet beim ersten
# Einschalten sein eigenes Netz. Der Kunde verbindet sich damit, ruft die
# Geräteseite auf und trägt sein WLAN dort ein - falls er es überhaupt will.
#
# Das ist zugleich Bedingung dafür, dass diese Eingabe erhalten bleibt: Laut
# ESPHome behält das Gerät gespeicherte Zugangsdaten nur, solange in der
# Konfiguration keine stehen.
# --------------------------------------------------------------------------
